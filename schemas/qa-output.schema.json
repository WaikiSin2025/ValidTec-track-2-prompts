{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidTec Track 2 QA Output",
  "type": "object",
  "required": [
    "case_id",
    "summary",
    "risks",
    "test_scenarios",
    "evidence_ids",
    "unknowns",
    "decision"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "ready",
        "needs_context"
      ]
    }
  }
}
